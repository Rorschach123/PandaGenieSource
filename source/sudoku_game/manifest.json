{
  "soLibraries": [],
  "h5Page": "index.html",
  "pluginJar": "plugin.jar",
  "soLoadMode": "skip",
  "capabilities": [],
  "permissions": [],
  "developer": {
    "name": "PandaGenie Games",
    "email": "games@pandagenie.ai",
    "url": "https://pandagenie.ai"
  },
  "id": "sudoku_game",
  "name": "数独",
  "name_en": "Sudoku",
  "description": "经典 9x9 数独，支持难度生成、填数、清格、检查和提示。",
  "description_en": "Classic 9x9 Sudoku with difficulty generation, input, clear, board check, and hints.",
  "version": "1.3",
  "icon": "grid_on",
  "pluginClass": "ai.rorsch.moduleplugins.sudoku_game.SudokuPlugin",
  "apis": [
    {
      "name": "startGame",
      "desc": "按难度生成新的数独题目",
      "desc_en": "Generate a new Sudoku puzzle by difficulty",
      "params": [
        "difficulty"
      ],
      "paramDesc": [
        "难度 1-3，默认 2"
      ],
      "paramDesc_en": [
        "Difficulty 1-3, default 2"
      ]
    },
    {
      "name": "placeNumber",
      "desc": "在指定单元格填入数字",
      "desc_en": "Place a number in a cell",
      "params": [
        "row",
        "col",
        "number"
      ],
      "paramDesc": [
        "行号 0-8",
        "列号 0-8",
        "数字 1-9"
      ],
      "paramDesc_en": [
        "Row 0-8",
        "Column 0-8",
        "Number 1-9"
      ]
    },
    {
      "name": "clearCell",
      "desc": "清除玩家填入的数字",
      "desc_en": "Clear a player-filled cell",
      "params": [
        "row",
        "col"
      ],
      "paramDesc": [
        "行号 0-8",
        "列号 0-8"
      ],
      "paramDesc_en": [
        "Row 0-8",
        "Column 0-8"
      ]
    },
    {
      "name": "checkBoard",
      "desc": "检查当前棋盘是否完成且正确",
      "desc_en": "Check whether the board is complete and correct",
      "params": [],
      "paramDesc": [],
      "paramDesc_en": []
    },
    {
      "name": "getHint",
      "desc": "获取一个空格提示",
      "desc_en": "Get a hint for an empty cell",
      "params": [],
      "paramDesc": [],
      "paramDesc_en": []
    },
    {
      "name": "getState",
      "desc": "获取当前数独状态",
      "desc_en": "Get current Sudoku state",
      "params": [],
      "paramDesc": [],
      "paramDesc_en": []
    },
    {
      "name": "restart",
      "desc": "按当前难度重新生成题目",
      "desc_en": "Generate a new puzzle with current difficulty",
      "params": [],
      "paramDesc": [],
      "paramDesc_en": []
    }
  ]
}
